# Fix script run karein (Python):
import json

with open('submitted_urls.json', 'r', encoding='utf-8') as f:
    data = json.load(f)

# Har URL se trailing space hatayein
data = [url.strip() for url in data]

with open('submitted_urls.json', 'w', encoding='utf-8') as f:
    json.dump(data, f, indent=2)

print("✅ Fixed trailing spaces in submitted_urls.json")
